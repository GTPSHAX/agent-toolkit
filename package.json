{
  "name": "@gtpshax/agent-toolkit",
  "version": "1.0.0",
  "description": "Standalone TypeScript toolkit of agent-callable tools with MCP-compatible output.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-toolkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "gts lint",
    "fix": "gts fix",
    "docs": "doxygen Doxyfile",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "tools",
    "cli",
    "typescript"
  ],
  "author": "Rafie Hasannudin <rafiehasannudin@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTPSHAX/agent-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/GTPSHAX/agent-toolkit/issues"
  },
  "homepage": "https://github.com/GTPSHAX/agent-toolkit#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "gts": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
